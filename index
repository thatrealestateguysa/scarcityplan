                    <div class="generated-report relative">
                        <!-- Watermark effect -->
                        <div class="absolute top-0 right-0 p-4 opacity-10 pointer-events-none">
                            <div class="text-8xl font-black text-black uppercase">Fry Box</div>
                        </div>

                        <div class="border-b-4 border-red-600 pb-4 mb-6 flex justify-between items-end">
                            <div>
                                <h2 class="text-3xl font-black text-black uppercase">Strategy Plan</h2>
                                <p class="text-red-700 font-bold text-lg mt-1" id="out-area"></p>
                            </div>
                            <div class="text-right text-sm text-gray-500 font-mono">
                                CONFIDENTIAL
                            </div>
                        </div>

                        <!-- Section 1: Market Audit -->
                        <div class="mb-8">
                            <h3 class="text-lg font-bold text-black mb-2 uppercase border-b border-gray-300">1. Market Data</h3>
                            <div class="bg-gray-100 p-4 rounded border border-gray-300 mb-4">
                                <p class="font-bold text-gray-800 mb-1">12-Month Sales Status:</p>
                                <p id="out-status" class="text-gray-700 whitespace-pre-wrap text-sm font-mono"></p>
                            </div>
                            <div class="flex space-x-4 text-sm">
                                <a id="out-p24" href="#" target="_blank" class="text-red-700 hover:underline font-bold">
                                    → Property24 Competition
                                </a>
                                <a id="out-pp" href="#" target="_blank" class="text-red-700 hover:underline font-bold">
                                    → Private Property Competition
                                </a>
                            </div>
                        </div>

                        <!-- Section 2: The Strategy -->
                        <div class="mb-8">
                            <h3 class="text-lg font-bold text-black mb-2 uppercase border-b border-gray-300">2. Execution Strategy</h3>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h4 class="font-bold text-gray-900 text-sm">DIAGNOSIS:</h4>
                                    <div id="out-temp-badge" class="inline-block px-3 py-1 rounded-sm text-sm font-black mb-4 uppercase tracking-wide border"></div>
                                    
                                    <h4 class="font-bold text-gray-900 text-sm">PRICING PROTOCOL:</h4>
                                    <p id="out-pricing" class="text-gray-700 text-sm mb-4"></p>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 text-sm">ACCESS CONTROL:</h4>
                                    <p id="out-access" class="text-gray-700 text-sm mb-4"></p>

                                    <h4 class="font-bold text-gray-900 text-sm">VISUAL STRATEGY:</h4>
                                    <p id="out-photos" class="text-gray-700 text-sm"></p>
                                </div>
